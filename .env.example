# ClaimGraph configuration. Copy to `.env` (repo root) and adjust.
# Every variable is prefixed CLAIMGRAPH_ so it can never collide with other
# projects' generic names (DATABASE_URL, OLLAMA_MODEL, ...). All are optional:
# with no .env at all, ClaimGraph runs with free, keyless public APIs,
# local ONNX models and no LLM.

# --- Mode --------------------------------------------------------------------
# true = use the bundled demo corpus (10 real arXiv abstracts); no network search.
CLAIMGRAPH_DEMO_MODE=false

# --- Literature discovery (all free) ------------------------------------------
# Contact email sent to OpenAlex / arXiv / Unpaywall as a courtesy.
# Also REQUIRED to enable Unpaywall open-access lookups.
CLAIMGRAPH_CONTACT_EMAIL=
# Optional. Keyless OpenAlex = $0.10/day budget (~100 searches). A free key from
# https://openalex.org/settings/api raises this to $1/day (~1,000 searches).
CLAIMGRAPH_OPENALEX_API_KEY=
# Optional. The keyless Semantic Scholar pool is shared and often returns 429;
# ClaimGraph then continues with the other sources. Free key: https://www.semanticscholar.org/product/api#api-key-form
CLAIMGRAPH_SEMANTIC_SCHOLAR_API_KEY=
# Comma-separated: openalex, semantic_scholar, arxiv, europepmc
# (europepmc is added automatically for biomedical questions)
CLAIMGRAPH_SOURCES=openalex,semantic_scholar,arxiv
CLAIMGRAPH_MAX_PAPERS=8
CLAIMGRAPH_DOWNLOAD_PDFS=true

# --- LLM (optional) ------------------------------------------------------------
# auto | none | openrouter | ollama | openai_compatible | huggingface
# auto (default) = OpenRouter when CLAIMGRAPH_LLM_API_KEY is set, otherwise no LLM.
# The pipeline is complete without an LLM. With one, the LLM (1) screens the verbatim claim
# candidates of each paper, (2) analyses each candidate claim pair: stance + a context table whose
# every value must be backed by a verbatim quote, and (3) writes a grounded summary. The relation
# and the conflict verdict are always decided by the rules.
CLAIMGRAPH_LLM_PROVIDER=auto
# An OpenRouter key (https://openrouter.ai/keys); also used as the key for openai_compatible / huggingface.
CLAIMGRAPH_LLM_API_KEY=
# Empty = provider default: openrouter -> inclusionai/ling-3.0-flash, ollama -> qwen2.5:7b
CLAIMGRAPH_LLM_MODEL=
# OpenRouter serves a model through several upstream hosts that differ in speed and quantisation.
# Preferred host ("" = any); experiments pin it strictly so results are reproducible.
CLAIMGRAPH_LLM_ROUTE=Novita
# Let a reasoning model think before answering (slower, costlier, less reproducible)
CLAIMGRAPH_LLM_REASONING=false
# Hard budget of LLM calls per analysis. 0 = provider default (80 hosted, 6 for a local Ollama model)
CLAIMGRAPH_LLM_MAX_CALLS=0
CLAIMGRAPH_LLM_CONCURRENCY=6
CLAIMGRAPH_LLM_TIMEOUT_S=180
# Replay identical LLM calls from backend/data/llm_cache.jsonl (repeatable runs)
CLAIMGRAPH_LLM_CACHE=true
# LLM screens each paper's verbatim claim candidates (it can keep or drop, never rewrite)
CLAIMGRAPH_LLM_CLAIM_SELECTION=true
# LLM stance + grounded context comparison per candidate pair
CLAIMGRAPH_LLM_PAIR_ANALYSIS=true
# LLM writes the claims itself (grounding-checked). Off by default: selection keeps claims verbatim.
CLAIMGRAPH_LLM_FOR_EXTRACTION=false
# Only for ollama
CLAIMGRAPH_OLLAMA_BASE_URL=http://localhost:11434
# Only for openai_compatible (Groq, vLLM, LM Studio, llama.cpp server, ...)
CLAIMGRAPH_LLM_API_BASE_URL=

# --- Local models (downloaded once from Hugging Face, no token needed) -------
# fastembed | hashing  (hashing = no download, lower quality)
CLAIMGRAPH_EMBEDDING_BACKEND=fastembed
# onnx | lexical
CLAIMGRAPH_NLI_BACKEND=onnx

# --- Storage -------------------------------------------------------------------
# Defaults to backend/data/claimgraph.db (SQLite). Change only if you need to.
# CLAIMGRAPH_DATABASE_URL=sqlite:////absolute/path/claimgraph.db

# --- Server --------------------------------------------------------------------
# Browser origins allowed to call the API. Add yours if you serve the frontend elsewhere.
# CLAIMGRAPH_CORS_ORIGINS=http://localhost:5199,http://127.0.0.1:5199
